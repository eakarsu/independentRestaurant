# Copy to a secret manager or local .env; never commit real values.
DATABASE_URL=postgresql://restaurant:change-me@127.0.0.1:5432/restaurant
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes

# Use a jurisdiction-reviewed configured rate, or TAX_PROVIDER_URL/TOKEN.
TAX_RATE_BPS=875
# TAX_PROVIDER_URL=https://tax-provider.example
# TAX_PROVIDER_TOKEN=secret

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=operations@example.com
RESTAURANT_NAME=Independent Restaurant

FULFILLMENT_PROVIDER_URL=
FULFILLMENT_PROVIDER_TOKEN=
INVENTORY_PROVIDER_URL=
INVENTORY_PROVIDER_TOKEN=

PARTNER_WEBHOOK_SECRET_DOORDASH=
INTERNAL_WORKER_SECRET=
CORS_ORIGIN=

# One-time administrative CLI only; unset after provisioning.
# ALLOW_USER_PROVISION=1
# PROVISION_USER_EMAIL=owner@example.com
# PROVISION_USER_NAME=Restaurant Owner
# PROVISION_USER_PASSWORD=use-a-password-manager
# PROVISION_USER_ROLE=MERCHANT

# Local-only demo autofill; keep real values in the ignored .env file.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
