{
  "name": "independent-restaurant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "node scripts/validate-runtime.mjs && next start",
    "lint": "eslint . --quiet",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:auth-routing": "node scripts/check-auth-routes.mjs",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "worker:once": "tsx scripts/process-outbox.ts",
    "user:provision": "tsx scripts/provision-user.ts",
    "create-admin": "tsx scripts/provision-user.ts",
    "demo-data:load": "node scripts/load-demo-data.cjs",
    "demo-data:verify": "node scripts/load-demo-data.cjs --verify",
    "test:operations": "node scripts/test-operations.cjs",
    "test:restore": "node scripts/verify-restore.cjs",
    "test:startup": "node scripts/test-port-cleanup.cjs"
  },
  "dependencies": {
