    "next-auth": "4.24.15",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.50.0",
    "recharts": "^2.12.0",
    "resend": "^6.12.2",
    "socket.io": "^4.8.3",
    "stripe": "^22.1.0",
    "tailwind-merge": "^2.2.0",
    "twilio": "^6.1.0",
    "zod": "^3.22.0"
